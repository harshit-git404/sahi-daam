# Sahi Daam Backend — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to Git.

# ── AI / Vision ──────────────────────────────────────────────────────────────
# Google Gemini API key (used for produce identification and freshness analysis)
GEMINI_API_KEY=your_gemini_api_key_here
# Gemini model to use (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# ── data.gov.in ───────────────────────────────────────────────────────────────
# API key for data.gov.in (used for Agmarknet and all sector datasets)
DATA_GOV_API_KEY=your_data_gov_api_key_here

# ── Agmarknet ─────────────────────────────────────────────────────────────────
# Resource ID for Agmarknet mandi prices (default is the verified public ID)
AGMARKNET_RESOURCE_ID=35985678-0d79-46b4-9ed6-6f13308a1d24

# ── Default Location ──────────────────────────────────────────────────────────
# Fallback state used when the user has not selected a location
DEFAULT_STATE=Tamil Nadu

# ── Sector Resource IDs ───────────────────────────────────────────────────────
# Add verified data.gov.in Resource IDs below when confirmed.
# Leave blank until the Resource API schema has been verified.
FERTILIZER_RESOURCE_ID=
FOOD_WASTE_RESOURCE_ID=
POST_HARVEST_RESOURCE_ID=
FOOD_PACKAGING_RESOURCE_ID=
FOSSIL_FUELS_RESOURCE_ID=
FOSSIL_SUBSIDIES_RESOURCE_ID=
RENEWABLE_ENERGY_RESOURCE_ID=
ELECTRICITY_GRID_RESOURCE_ID=
INDUSTRIAL_WASTEWATER_RESOURCE_ID=
AGRICULTURAL_IRRIGATION_RESOURCE_ID=
MUNICIPAL_DRINKING_WATER_RESOURCE_ID=
EWASTE_RESOURCE_ID=
TEXTILE_RESOURCE_ID=
SINGLE_USE_PLASTIC_RESOURCE_ID=
DURABLE_GOODS_RESOURCE_ID=
INDUSTRIAL_CHEMICALS_RESOURCE_ID=
HOUSEHOLD_CHEMICALS_RESOURCE_ID=
HEAVY_METALS_RESOURCE_ID=
CONSTRUCTION_MATERIALS_RESOURCE_ID=
MINED_TECH_MINERALS_RESOURCE_ID=
AGGREGATES_RESOURCE_ID=
PUBLIC_PROCUREMENT_RESOURCE_ID=
CORPORATE_ESG_RESOURCE_ID=
